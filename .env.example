# Local runtime
NODE_ENV=development
PORT=3000
BDC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BDC OS

# Render PostgreSQL connection string. Juan manages the real value.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# Optional elevated connection used only for startup schema initialization/migrations.
DATABASE_MIGRATION_URL=
PGSSL=false

# Redis connection. Juan manages the real value; never commit it.
REDIS_URL=
BURST_BUFFER_SECONDS=15
# Redis control key must outlive the 15s window so expiry cannot race the flush.
BURST_BUFFER_CONTROL_TTL_SECONDS=90
CONTACT_MUTEX_TTL_SECONDS=30
# Keep qualification, AI, and outbound messaging disabled until the controlled pilot authorizes it.
QUALIFICATION_FLOW_ENABLED=false
QUALIFICATION_SIGNAL_ENABLED=false
SOFIA_ENABLED=false
SOFIA_DEALER_NAME=el dealer
# Hybrid conversational layer. It is shadow-only and disabled until a controlled pilot authorizes it.
CONVERSATIONAL_AI_ENABLED=false
CONVERSATIONAL_AI_SEND_ENABLED=false
CONVERSATIONAL_MODEL_BASE_URL=https://api.openai.com/v1
CONVERSATIONAL_MODEL_API_KEY=
CONVERSATIONAL_EXTRACTION_MODEL=gpt-5.6-luna
CONVERSATIONAL_DRAFTING_MODEL=gpt-5.6-luna
CONVERSATIONAL_MODEL_TIMEOUT_MS=20000
# Optional local-only media understanding; disabled keeps the existing text path unchanged.
MEDIA_UNDERSTANDING_ENABLED=false
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=
TESSERACT_CLI_PATH=
QUALIFICATION_SIGNAL_POLL_MS=5000
META_CAPI_EVENT_NAME=LeadSubmitted
META_CAPI_DEALERS_JSON={}
WEBHOOK_QUEUE_MAX_ATTEMPTS=5
WEBHOOK_QUEUE_BACKOFF_MS=1000
WEBHOOK_QUEUE_MAX_BACKOFF_MS=60000

# Meta application credentials (only required to enable dealer OAuth).
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/meta/callback
META_OAUTH_SCOPES=pages_show_list,pages_manage_metadata,pages_read_engagement,pages_messaging,instagram_basic,instagram_manage_messages,business_management,whatsapp_business_management,whatsapp_business_messaging
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v27.0

# High-entropy secrets managed by Juan. Never commit real values.
ENCRYPTION_SECRET=
OAUTH_STATE_SECRET=

# Internal diagnostics are disabled by default. When enabled, each tenant needs
# a unique 32+ byte token and a server-managed reviewer identity in this JSON map.
INTERNAL_DIAGNOSTICS_ENABLED=false
INTERNAL_DIAGNOSTIC_CREDENTIALS_JSON=
# Exact remote IPs only; required to enable the internal route in production.
INTERNAL_DIAGNOSTIC_ALLOWED_REMOTE_IPS=

# Candidate outbound messages above this normalized token-Jaccard score are vetoed.
SEMANTIC_SIMILARITY_THRESHOLD=0.8
