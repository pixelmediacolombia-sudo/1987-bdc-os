# Local runtime
NODE_ENV=development
PORT=3000

# Render PostgreSQL connection string. Juan manages the real value.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
PGSSL=false

# Redis connection. Juan manages the real value; never commit it.
REDIS_URL=
BURST_BUFFER_SECONDS=15
# Redis control key must outlive the 15s window so expiry cannot race the flush.
BURST_BUFFER_CONTROL_TTL_SECONDS=90
CONTACT_MUTEX_TTL_SECONDS=30
# Keep qualification, AI, and outbound messaging disabled until the controlled pilot authorizes it.
QUALIFICATION_FLOW_ENABLED=false
QUALIFICATION_SIGNAL_ENABLED=false
SOFIA_ENABLED=false
SOFIA_DEALER_NAME=el dealer
QUALIFICATION_SIGNAL_POLL_MS=5000
WEBHOOK_QUEUE_MAX_ATTEMPTS=5
WEBHOOK_QUEUE_BACKOFF_MS=1000
WEBHOOK_QUEUE_MAX_BACKOFF_MS=60000

# GHL Marketplace OAuth. Juan manages the real credentials.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_APP_VERSION_ID=6a84ce51032e61130732e5cd
GHL_REDIRECT_URI=http://localhost:3000/oauth/callback
GHL_AUTHORIZATION_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
GHL_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
GHL_SCOPES=

# High-entropy secrets managed by Juan. Never commit real values.
ENCRYPTION_SECRET=
OAUTH_STATE_SECRET=

# Optional but required to expose GET /tests/policy-evaluation safely.
# Juan manages the real value; never commit it.
POLICY_DIAGNOSTIC_TOKEN=

# Candidate outbound messages above this normalized token-Jaccard score are vetoed.
SEMANTIC_SIMILARITY_THRESHOLD=0.8
