# Local runtime
NODE_ENV=development
PORT=3000

# Render PostgreSQL connection string. Juan manages the real value.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
PGSSL=false

# Redis connection. Juan manages the real value; never commit it.
REDIS_URL=
BURST_BUFFER_SECONDS=15
# Redis control key must outlive the 15s window so expiry cannot race the flush.
BURST_BUFFER_CONTROL_TTL_SECONDS=90
CONTACT_MUTEX_TTL_SECONDS=30

# GHL Marketplace OAuth. Juan manages the real credentials.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_APP_VERSION_ID=6a84ce51032e61130732e5cd
GHL_REDIRECT_URI=http://localhost:3000/oauth/callback
GHL_AUTHORIZATION_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
GHL_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
GHL_SCOPES=

# High-entropy secrets managed by Juan. Never commit real values.
ENCRYPTION_SECRET=
OAUTH_STATE_SECRET=
